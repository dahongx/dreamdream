# Environment template — copy to .env.local and fill in.
# Never commit .env.local. .gitignore already covers .env*.
#
# 这是「本地非 Docker 开发」模板（Postgres.app + 本地 `supabase start`）。
# VPS 自托管全栈部署用 .env.docker.example（→ 复制成 .env）。

# Postgres 业务库。本地两种来源：
#   - 本地 `supabase start` 自带的 db：postgresql://USER:REPLACE_ME@HOST:5432/DATABASE
#   - Postgres.app：postgres://<mac-user>@localhost:5432/nimir_dev
DATABASE_URL=

# ===== Supabase（认证 + 对象存储）=====
# 本地跑 `supabase start`，它会打印下面这几个值，粘进来即可。
#   URL 本地形如 http://127.0.0.1:54321
# 注意：NEXT_PUBLIC_* 会被打进浏览器包，只能放 anon/publishable（受网关/RLS 约束），
#       绝不能放 service_role / secret key。
NEXT_PUBLIC_SUPABASE_URL=
# 浏览器可见的 anon key（`supabase start` 输出的 anon key）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端：图片上传到 Supabase Storage（bucket=media）用的 service key
# （`supabase start` 输出的 service_role key）。绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=

# ===== 账号注销 =====
# 已注销邮箱指纹的 pepper（HMAC-SHA256 的密钥）。注销是硬删除、邮箱会被释放，
# 这份指纹是唯一残留物，作用只有一个：同邮箱重注册时不再发新人币。
# 用 HMAC 而不是裸 SHA256 —— 邮箱空间小到可以字典枚举，裸哈希等于明文。
#
# ⚠️ 生产必须设置且**此后不能再改**：改了 pepper，历史指纹全部对不上，
#    所有注销过的邮箱都能重新领一次新人币。没设置时注销流程会直接失败
#    （刻意 fail-closed，不静默降级成可反查的裸哈希）。
# 生成：openssl rand -hex 32
ACCOUNT_DELETION_EMAIL_PEPPER=

# LLM provider keys (only the ones you actually use need to be set)
# Namespaced under NIMIR_* on purpose: many users export ANTHROPIC_BASE_URL
# globally for Claude Code or other tools, and shell env beats .env.local
# in Next/Bun. NIMIR_* keeps the project decoupled from that.
NIMIR_ANTHROPIC_API_KEY=
# Optional override — defaults to https://api.anthropic.com/v1 when blank.
# When using a compatible relay, include the /v1 suffix:
#   NIMIR_ANTHROPIC_BASE_URL=https://your-relay.example.com/v1
NIMIR_ANTHROPIC_BASE_URL=
# DeepSeek V4 Pro default chat/generation model via an Anthropic-compatible
# NewAPI channel. Base URL defaults to http://107.167.18.218:3000/v1 when blank.
NIMIR_DEEPSEEK_API_KEY=
NIMIR_DEEPSEEK_BASE_URL=
NIMIR_OPENAI_API_KEY=
# Optional override — defaults to https://api.openai.com/v1 when blank.
NIMIR_OPENAI_BASE_URL=
# Optional image model override for compatible relays.
NIMIR_OPENAI_IMAGE_MODEL=gpt-image-2
# Legacy fallback also works if already present in your shell.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini via OpenAI-compat relay (NewAPI). Base URL defaults to
# http://107.167.18.218:3000/v1 when blank — always keep the /v1 suffix
# (NewAPI routes /chat/completions under it; strip it and the request
# falls through to the SPA index HTML).
NIMIR_GOOGLE_API_KEY=
NIMIR_GOOGLE_BASE_URL=
# Inert while Gemini goes via OpenAI-compat: NewAPI drops google.thinkingConfig.
# Kept as env names so switching back to Google native REST is zero-code.
NIMIR_GEMINI_THINKING_BUDGET=8192
NIMIR_GEMINI_THINKING_LEVEL=high

# ===== Stripe（真实支付：卡 / 支付宝 / 微信）=====
# 月卡走 Stripe Checkout 一次性付款（mode:payment）。支付宝/微信只支持一次性，
# 不支持订阅，所以月卡是「买断 30 天」。前提：Stripe 账号注册地需支持 Alipay +
# WeChat Pay（大陆主体一般不行，需境外/HK/SG 主体），并在 Dashboard 启用这三种。
#
# 服务端密钥（test 模式形如 sk_test_...）。绝不能加 NEXT_PUBLIC_ 前缀。
STRIPE_SECRET_KEY=
# webhook 验签密钥。本地用 `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# 输出的 whsec_...；生产用 Dashboard webhook endpoint 的 signing secret。
STRIPE_WEBHOOK_SECRET=
# 应用对外可访问的根地址，用于 Checkout 成功/取消回跳。
#   本地：http://localhost:3000  生产：https://dearm.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== 支付渠道选择 =====
# 默认 stripe；配置为 payproo 后，商城月卡和金币包走 PayProo 收款。
PAYMENT_PROVIDER=stripe

# ===== PayProo（可选香港 HKD / 台湾 TWD）=====
# PAYMENT_PROVIDER=payproo 时必填。测试与生产账号、密钥不通用。
PAYPROO_ENVIRONMENT=test
PAYPROO_REGION=hk
# 可选；不填时按 PAYPROO_ENVIRONMENT 使用官方地址。
# PAYPROO_BASE_URL=https://api.payproo.tech
PAYPROO_APP_ID=
PAYPROO_PAY_TYPE=EWALLET
PAYPROO_MERCHANT_SECRET_KEY=
# 支持 .env 中使用 \n，或直接使用多行 PEM。
PAYPROO_MERCHANT_PRIVATE_KEY=
# 或使用本机/服务器上的私钥文件路径；配置文件路径后无需复制私钥内容。
# PAYPROO_MERCHANT_PRIVATE_KEY_FILE=/absolute/path/to/payproo_private.pem
PAYPROO_PLATFORM_PUBLIC_KEY=
# 香港：WECHAT / ALIPAY / OCTOPUS；台湾：CREDIT_CARD / APPLEPAY / JKOPAY /
# BANKTRANSFER / OTC_STORE。默认 ALIPAY。
PAYPROO_PAY_MODEL=ALIPAY
