# Supabase Cloud 部署环境模板 —— 复制成 .env 后填值。
#   cp .env.cloud.example .env
# 之后跑：bash deploy/deploy-cloud.sh
#
# 与自托管版（deploy/supabase/.env.supabase.example）不同：
# 这里没有 JWT_SECRET / ANON_KEY 自签、没有 kong / gotrue 内网地址 ——
# 认证、存储、数据库全在 https://<project-ref>.supabase.co 上，直接填云端控制台给的值。
# 取值位置：Supabase Dashboard → Project Settings → API / Database。

# ===== Compose 文件锁定 =====
# 不带 -f 的裸 `docker compose` 默认加载 docker-compose.yml —— 那是自托管编排，
# 它 `include` 了整套本地 supabase（db/kong/auth/rest/storage/imgproxy）。云端部署下
# 误跑一次就会凭空创建 6 个用不上的容器（2026-08-10 线上踩过）。锁死到 cloud 文件，
# 之后裸跑 `docker compose ps/logs/up` 都自动指向正确编排。
COMPOSE_FILE=docker-compose.cloud.yml

# ===== 应用 =====
APP_PORT=3000
TZ=Asia/Shanghai
# 对外根地址（Stripe 回跳 + 邮件里的绝对链接用）。生产填带域名的 https 地址。
NEXT_PUBLIC_APP_URL=https://dearm.ai
# 反代背后拿不到 Host 时的兜底 origin（一般与上面同值）。
SITE_URL=https://dearm.ai

# ===== Supabase Cloud（认证 + 存储 + 数据库）=====
# 迁移 + 运行时连库。DDL 迁移用 session pooler(5432) 更稳；运行时也可用 transaction pooler(6543)。
# 代码已全局 prepare:false，两种端口都安全。密码 = Dashboard → Database 里的库密码。
DATABASE_URL=postgresql://USER:REPLACE_ME@HOST:5432/DATABASE

# 浏览器可见的公开 URL（会被内联进前端包）。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 浏览器可见的 publishable / anon key（受 RLS 约束，可公开）。二选一填一个即可。
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 仅服务端：图片上传到 Storage(bucket=media) 用的 secret key，账号注销调
# auth.admin.deleteUser 也用它。绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ===== 账号注销 =====
# 已注销邮箱指纹的 pepper。注销是硬删除、邮箱会被释放，这份指纹是唯一残留物，
# 作用只有一个：同邮箱重注册时不再发新人币。
# ⚠️ 必须设置且**此后不能再改**（改了历史指纹全部失效，注销过的邮箱能再领一次）。
# 没设置时注销会直接失败——刻意 fail-closed，不降级成可字典枚举的裸哈希。
# 生成：openssl rand -hex 32
ACCOUNT_DELETION_EMAIL_PEPPER=

# ===== LLM provider（至少一个才能聊通；默认模型走 DeepSeek）=====
NIMIR_DEEPSEEK_API_KEY=
# NIMIR_DEEPSEEK_BASE_URL=            # 缺省 http://107.167.18.218:3000/v1
# NIMIR_ANTHROPIC_API_KEY=
# NIMIR_OPENAI_API_KEY=
# NIMIR_GOOGLE_API_KEY=
# NIMIR_GOOGLE_BASE_URL=              # 缺省 http://107.167.18.218:3000/v1（Gemini 走 OpenAI-compat 中转）

# ===== Stripe（真实支付；不收钱可先留空，聊天/浏览不受影响）=====
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
