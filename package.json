{
  "name": "nimir",
  "version": "1.0.0",
  "description": "寄情 (Dearm) — Web 多用户 AI 角色聊天平台。creator 友好 + 内置 AI 辅助 + 调试模式 + 零内容审核。域名 dearm.ai。",
  "private": true,
  "type": "module",
  "patchedDependencies": {
    "css-tree@3.2.1": "patches/css-tree@3.2.1.patch",
    "next@16.2.6": "patches/next@16.2.6.patch"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && bun scripts/check-character-client-manifest.ts",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test src/",
    "prompt:sync": "bun scripts/sync-master-prompt.ts",
    "prompt:check": "bun scripts/sync-master-prompt.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:migrate:backfill": "bun scripts/db-migrate.ts --backfill",
    "backfill:cost": "bun scripts/backfill-message-cost.ts",
    "backfill:cost:dry": "bun scripts/backfill-message-cost.ts --dry-run",
    "backfill:currency-tx": "bun scripts/backfill-currency-transactions.ts",
    "backfill:currency-tx:dry": "bun scripts/backfill-currency-transactions.ts --dry-run",
    "backfill:imported-rules": "bun scripts/backfill-imported-rule-render.ts",
    "backfill:imported-rules:dry": "bun scripts/backfill-imported-rule-render.ts --dry-run",
    "mufy:migrate": "bun scripts/migrate-mufy-card.ts",
    "mufy:migrate:batch": "bun scripts/migrate-mufy-batch.ts",
    "mufy:agent": "bun scripts/run-mufy-migration-agent.ts",
    "mufy:verify": "bun scripts/verify-mufy-visual-parity.ts",
    "mufy:profiles": "bun scripts/mufy-profile-pipeline.ts",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/react": "^3.0.186",
    "@auth/drizzle-adapter": "^1.11.2",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@fontsource/noto-serif-jp": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "ai": "^6.0.184",
    "bcryptjs": "^3.0.3",
    "css-tree": "3.2.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.12.0",
    "isomorphic-dompurify": "^3.13.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.5.0",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp",
    "unrs-resolver"
  ]
}
